# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Node.js environment
NODE_ENV=development

# Application port (if needed for standalone operation)
PORT=5000

# =============================================================================
# AI/ML SERVICE CREDENTIALS
# =============================================================================

# OpenAI API Key for invoice data extraction
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Alternative environment variable name (if using different naming convention)
OPENAI_API_KEY_ENV_VAR=your-openai-api-key-here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL database connection string
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_processing

# =============================================================================
# ERP SYSTEM CREDENTIALS
# =============================================================================

# SINCO ERP System (Primary ERP)
SINCO_BASE_URL=https://your-sinco-instance.com
SINCO_USERNAME=your-sinco-username
SINCO_PASSWORD=your-sinco-password

# =============================================================================
# ORCHESTRATOR SPECIFIC SETTINGS
# =============================================================================

# Override default timeouts (in seconds)
# ORCHESTRATOR_TIMEOUT_IMPORT=120
# ORCHESTRATOR_TIMEOUT_OCR=180
# ORCHESTRATOR_TIMEOUT_AI=180
# ORCHESTRATOR_TIMEOUT_XML=120
# ORCHESTRATOR_TIMEOUT_VALIDATE=90
# ORCHESTRATOR_TIMEOUT_ERP=180
# ORCHESTRATOR_TIMEOUT_RECONCILE=120
# ORCHESTRATOR_TIMEOUT_NOTIFY=60

# Retry configuration
# ORCHESTRATOR_MAX_RETRIES=5
# ORCHESTRATOR_RETRY_INITIAL_DELAY=2
# ORCHESTRATOR_RETRY_MAX_DELAY=60

# Concurrency settings
# ORCHESTRATOR_MAX_WORKERS=4

# Disable specific stages (comma-separated list)
# ORCHESTRATOR_DISABLE_STAGES=erp_post,notify

# =============================================================================
# AUTHENTICATION AND SECURITY
# =============================================================================

# Session secret for secure sessions
SESSION_SECRET=your-super-secure-session-secret-change-this

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Logging Level
LOG_LEVEL=INFO

# Enable debug mode for development
DEBUG_MODE=true

# Enable verbose logging in development
VERBOSE_LOGGING=true